#!/usr/bin/expect -f
set timeout 300
spawn ssh -o StrictHostKeyChecking=no root@47.99.138.250
expect {
    "password:" { send "Chineseman.\r" }
    timeout { puts "TIMEOUT"; exit 1 }
}
expect "# "
send "apt-get update -qq && apt-get install -y certbot python3-certbot-nginx && echo APT_DONE\r"
expect {
    "APT_DONE" { puts "INSTALL_OK" }
    timeout { puts "APT_TIMEOUT"; exit 1 }
}
expect "# "
send "certbot --nginx -d europewedding.cn -d www.europewedding.cn --non-interactive --agree-tos --email admin@europewedding.cn && echo CERT_ISSUED\r"
expect {
    "CERT_ISSUED" { puts "CERT_SUCCESS" }
    timeout { puts "CERT_TIMEOUT" }
}
expect "# "
send "cat /etc/nginx/sites-enabled/verra-voile\r"
expect "# "
send "curl -sI https://europewedding.cn 2>&1 | head -5\r"
expect "# "
send "exit\r"
expect eof
