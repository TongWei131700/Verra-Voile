#!/usr/bin/expect -f
set timeout 180
spawn ssh -o StrictHostKeyChecking=no root@47.99.138.250
expect {
    "password:" {
        send "Chineseman.\r"
    }
    timeout {
        puts "CONN_TIMEOUT"
        exit 1
    }
}
expect "# "
send "snap install --classic certbot && ln -sf /snap/bin/certbot /usr/bin/certbot && echo CERTBOT_INSTALLED\r"
expect {
    "CERTBOT_INSTALLED" {
        puts "INSTALL_OK"
    }
    timeout {
        puts "INSTALL_TIMEOUT"
    }
}
expect "# "
send "certbot --nginx -d europewedding.cn -d www.europewedding.cn --non-interactive --agree-tos --email admin@europewedding.cn\r"
expect {
    "# " {
        puts "CERTBOT_DONE"
    }
    timeout {
        puts "CERTBOT_TIMEOUT"
    }
}
send "cat /etc/nginx/sites-enabled/verra-voile\r"
expect "# "
send "exit\r"
expect eof
